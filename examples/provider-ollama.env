# Minimal local Ollama provider demo.
#
# Dry-run contract smoke does not require Ollama:
#   npm run smoke:ollama-provider
#
# Live local model smoke:
#   ollama serve
#   ollama pull llama3.2
#   set -a
#   source examples/provider-ollama.env
#   set +a
#   MAB_RUN_OLLAMA_PROVIDER_SMOKE=1 npm run smoke:ollama-provider
#   npm run smoke:local-agent-dialog

MAB_AGENT_RUNNER=ollama
MAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
MAB_OLLAMA_MODEL=llama3.2
MAB_BROWSER_HEADLESS=true
