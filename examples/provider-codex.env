# Minimal local Codex provider demo.
#
# Run:
#   set -a
#   source examples/provider-codex.env
#   set +a
#   npm run smoke:local-agent-dialog

MAB_AGENT_RUNNER=codex
MAB_CODEX_BIN=codex
MAB_CODEX_MODEL=gpt-5.5
MAB_BROWSER_HEADLESS=true

# Optional OpenRouter Responses-compatible Codex provider.
# export OPENROUTER_API_KEY=...
# MAB_CODEX_MODEL_PROVIDER=openrouter
# MAB_CODEX_BASE_URL=https://openrouter.ai/api/v1
# MAB_CODEX_ENV_KEY=OPENROUTER_API_KEY
# MAB_CODEX_WIRE_API=responses
# MAB_CODEX_MODEL=deepseek/deepseek-v4-pro
