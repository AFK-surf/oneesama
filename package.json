    "test": "npm run lint:size && node --import tsx --test --test-reporter=spec \"test/**/*.test.{js,mjs}\"",
    "ci": "npm run lint && npm run setup:browsers && npm run doctor && npm run smoke && npm run smoke:agent-provider && npm run smoke:agent-real-task && npm run smoke:claude-provider && npm run smoke:codex-app-server-provider && npm run smoke:ollama-provider && npm run smoke:slack-agent-d-provider && npm run smoke:slack-live-capability && npm run smoke:slack-memory && npm run smoke:dialog-provider && npm run smoke:post-meeting && npm run smoke:meetd-api-compat && npm run smoke:meetd-runtime-store && npm run smoke:digest-webhook && npm run smoke:meeting-copilot && npm run smoke:state-provider && npm run smoke:local-agent-dialog && npm run smoke:local-browser-surface && npm run smoke:caption-local-dialog && npm run smoke:avatar && npm run smoke:meet && npm run smoke:meet-contract && npm run smoke:persistence && npm run smoke:worker-bridge && npm run smoke:realtime-browser && npm run smoke:realtime-webrtc && npm run smoke:realtime-participant-audio && npm run smoke:realtime-meet-receiver && npm run smoke:realtime-audio-route && npm run smoke:realtime-repeat-guard && npm run smoke:realtime-session-update && npm run smoke:realtime-worker-tool && npm run smoke:avatar-state && npm run smoke:avatar-visual && npm run smoke:hiyori-live2d && npm run smoke:runtime-acceptance && npm run smoke:slack-results && npm run smoke:slack-posting && npm run smoke:slack-contract && npm run smoke:slack-mrkdwn-renderer && npm run smoke:slack-assistant-schedule && npm run smoke:slack-assistant-schedule-service && npm run smoke:slack-workspace-bootstrap && npm run smoke:slack-install && npm run smoke:cutover-shadow && npm run smoke:cutover-rollback && npm run smoke:shadow-parity && npm run smoke:shadow-tap && npm run smoke:shadow-transmitter && npm run smoke:cutover-evidence && npm run smoke:realtime-sdk && npm run smoke:realtime-live-tool && npm run smoke:realtime && npm run smoke:slack",
    "smoke": "tsx src/cli.ts smoke",
    "smoke:agent-provider": "tsx src/cli.ts agent-provider-smoke",
    "smoke:agent-real-task": "tsx src/cli.ts agent-real-task-smoke",
    "smoke:claude-provider": "tsx src/cli.ts claude-provider-smoke",
    "smoke:codex-app-server-provider": "tsx src/cli.ts codex-app-server-provider-smoke",
    "smoke:ollama-provider": "tsx src/cli.ts ollama-provider-smoke",
    "smoke:slack-agent-d-provider": "tsx src/cli.ts slack-agent-d-provider-smoke",
    "smoke:slack-live-capability": "tsx src/cli.ts slack-live-capability-smoke",
    "smoke:slack-live-socket": "tsx src/cli.ts slack-live-socket-smoke",
    "slack:memory-seed": "tsx src/cli.ts slack-memory-seed",
    "smoke:slack-memory": "tsx src/cli.ts slack-memory-smoke",
    "smoke:dialog-provider": "tsx src/cli.ts dialog-provider-smoke",
    "smoke:post-meeting": "tsx src/cli.ts post-meeting-smoke",
    "smoke:meetd-api-compat": "tsx src/cli.ts meetd-api-compat-smoke",
    "smoke:meetd-runtime-store": "tsx src/cli.ts meetd-runtime-store-smoke",
    "smoke:digest-webhook": "tsx src/cli.ts digest-webhook-smoke",
    "smoke:meeting-copilot": "tsx src/cli.ts meeting-copilot-smoke",
    "smoke:canvas-publisher": "tsx src/cli.ts canvas-publisher-smoke",
    "smoke:slack-mrkdwn-renderer": "tsx src/cli.ts slack-mrkdwn-renderer-smoke",
    "smoke:slack-assistant-schedule": "tsx src/cli.ts slack-assistant-schedule-smoke",
    "smoke:slack-assistant-schedule-service": "tsx src/cli.ts slack-assistant-schedule-service-smoke",
    "smoke:slack-workspace-bootstrap": "tsx src/cli.ts slack-workspace-bootstrap-smoke",
    "smoke:slack-install": "tsx src/cli.ts slack-install-smoke",
    "smoke:slack-tool-registry": "tsx src/cli.ts slack-tool-registry-smoke",
    "smoke:slack-domain-store": "tsx src/cli.ts slack-domain-store-smoke",
    "smoke:slack-triage-flow": "tsx src/cli.ts slack-triage-flow-smoke",
    "smoke:state-provider": "tsx src/cli.ts state-provider-smoke",
    "smoke:local-agent-dialog": "tsx src/cli.ts local-agent-dialog-smoke",
    "smoke:local-browser-surface": "node --import tsx --test --test-reporter=spec test/local-browser-surface.test.mjs",
    "smoke:caption-local-dialog": "tsx src/cli.ts caption-local-dialog-smoke",
    "smoke:avatar": "tsx src/cli.ts avatar-smoke",
    "smoke:avatar-playground": "node --import tsx --test --test-reporter=spec test/avatar-playground.test.mjs",
    "smoke:meet": "tsx src/cli.ts meet-smoke",
    "smoke:meet-contract": "tsx src/cli.ts meet-contract-smoke",
    "smoke:docker-meeting-surfaces": "./scripts/docker-meeting-surfaces-smoke.sh",
    "smoke:screen-share": "tsx src/cli.ts screen-share-smoke",
    "smoke:real-meet": "tsx src/cli.ts real-meet-smoke",
    "smoke:real-meet-synthetic-speaker": "node --import tsx scripts/real-meet-synthetic-speaker-smoke.mjs",
    "smoke:real-local-dialog": "tsx src/cli.ts real-local-dialog-smoke",
    "smoke:persistence": "tsx src/cli.ts persistence-smoke",
    "smoke:worker-bridge": "tsx src/cli.ts worker-bridge-smoke",
    "smoke:realtime-browser": "tsx src/cli.ts realtime-browser-smoke",
    "smoke:realtime-agents-sdk": "node --import tsx --test --test-reporter=spec test/realtime-agents-sdk-adapter.test.mjs",
    "smoke:realtime-webrtc": "tsx src/cli.ts realtime-webrtc-smoke",
    "smoke:realtime-participant-audio": "tsx src/cli.ts realtime-participant-audio-smoke",
    "smoke:realtime-meet-receiver": "node --import tsx --test --test-reporter=spec test/realtime-browser-bridge-meet-receiver-smoke.test.mjs",
    "smoke:realtime-audio-route": "tsx src/cli.ts realtime-audio-route-smoke",
    "smoke:realtime-synthetic-speech": "node --import tsx scripts/real-meet-synthetic-speaker-smoke.mjs --local-fixture",
    "smoke:realtime-repeat-guard": "tsx src/cli.ts realtime-repeat-guard-smoke",
    "smoke:realtime-session-update": "tsx src/cli.ts realtime-session-update-smoke",
    "smoke:realtime-worker-tool": "tsx src/cli.ts realtime-worker-tool-smoke",
    "smoke:avatar-state": "tsx src/cli.ts avatar-state-smoke",
    "smoke:avatar-visual": "tsx src/cli.ts avatar-visual-smoke",
    "smoke:avatar-vrm": "tsx src/cli.ts avatar-vrm-smoke",
    "smoke:hiyori-live2d": "tsx src/cli.ts hiyori-live2d-smoke",
    "smoke:runtime-acceptance": "tsx src/cli.ts runtime-acceptance-smoke",
    "smoke:slack-results": "tsx src/cli.ts slack-result-smoke",
    "smoke:slack-posting": "tsx src/cli.ts slack-posting-smoke",
    "smoke:slack-contract": "tsx src/cli.ts slack-contract-smoke",
    "smoke:cutover-shadow": "tsx src/cli.ts cutover-shadow-smoke",
    "smoke:cutover-rollback": "tsx src/cli.ts cutover-rollback-smoke",
    "smoke:shadow-parity": "tsx src/cli.ts shadow-parity-smoke",
    "smoke:shadow-tap": "tsx src/cli.ts shadow-tap-smoke",
    "smoke:shadow-transmitter": "tsx src/cli.ts shadow-transmitter-smoke",
    "shadow:transmit": "tsx src/cli.ts shadow-transmitter-hook",
    "cutover:evidence": "tsx src/cli.ts cutover-evidence-bundle",
    "smoke:cutover-evidence": "tsx src/cli.ts cutover-evidence-smoke",
    "smoke:realtime-sdk": "tsx src/cli.ts realtime-sdk-smoke",
    "smoke:realtime-sdp": "tsx src/cli.ts realtime-sdk-smoke",
    "smoke:realtime-live-tool": "tsx src/cli.ts realtime-live-tool-smoke",
    "smoke:realtime-live-routing": "tsx src/cli.ts realtime-live-routing-smoke",
    "smoke:realtime": "tsx src/cli.ts realtime-smoke",
    "smoke:slack": "tsx src/cli.ts slack-smoke"
  },
  "dependencies": {
    "@openai/agents-realtime": "0.11.4",
    "@pixiv/three-vrm": "^2.1.3",
    "better-sqlite3": "^12.9.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.58.2",
    "three": "^0.164.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "meeting-bot",
    "slack",
    "google-meet",
    "live2d",
    "openai-realtime",
    "codex",
    "claude-code",
    "ollama",
    "slack-agent-d"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "lefthook": "^2.1.8",
    "oxlint": "^1.66.0",
