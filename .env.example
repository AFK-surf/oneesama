# Optional OpenAI Realtime provider. The bot can also use local agent
# providers below; OpenAI is not required for local smoke.
MAB_OPENAI_API_KEY=
MAB_OPENAI_BASE_URL=https://api.openai.com/v1
MAB_OPENAI_REALTIME_MODEL=gpt-realtime-2
MAB_OPENAI_REALTIME_REASONING_EFFORT=high
MAB_OPENAI_REALTIME_VOICE=marin
MAB_OPENAI_REALTIME_TURN_DETECTION=semantic_vad
MAB_OPENAI_REALTIME_SESSION_SCHEMA=realtime-2
# Optional current-user context for Realtime identity/tools.
MAB_CURRENT_USER_NAME=Operator
MAB_CURRENT_USER_ENGLISH_NAME=Operator
MAB_CURRENT_USER_EMAIL=operator@example.com
MAB_CURRENT_USER_LINEAR=operator
MAB_CURRENT_USER_GITHUB=operator
MAB_CURRENT_USER_ROLE=meeting operator
# Optional: live Realtime smokes are skipped by default, even when a key is present.
# Set MAB_RUN_REALTIME_SDP=1 / MAB_RUN_REALTIME_LIVE_TOOL=1 to run them.
# Set MAB_REQUIRE_* to fail instead of skip when the live provider is unavailable.
MAB_RUN_REALTIME_SDP=0
MAB_REQUIRE_REALTIME_SDP=0
MAB_RUN_REALTIME_LIVE_TOOL=0
MAB_REQUIRE_REALTIME_LIVE_TOOL=0

# Required for the Slack control plane.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
MAB_SLACK_SOCKET_MODE=0
MAB_SLACK_EVENT_BUFFER=1
MAB_SLACK_EVENT_DEBOUNCE_MS=300000
MAB_SLACK_EVENT_MAX_BATCH=20
MAB_SLACK_EVENT_TRIAGE=0
MAB_SLACK_TRIAGE_POST_ACTIONS=1
MAB_SLACK_TRIAGE_HEURISTIC_FALLBACK=1
# Slack-compatible tool adapters. `run_command` stays fail-closed unless
# explicitly enabled and allowlisted.
MAB_ENABLE_RUN_COMMAND_TOOL=0
MAB_RUN_COMMAND_ALLOWLIST=git,gh,curl,jq
MAB_RUN_COMMAND_TIMEOUT_MS=10000

# Optional private local memory seed from an existing Slack Agent D workspace.
# Keep this enabled only on trusted local machines. The seed directory contains
# private workspace memory and must never be committed.
MAB_SLACK_MEMORY_ENABLED=0
MAB_SLACK_MEMORY_DIR=/tmp/meeting-avatar-bot-data/slack-memory
MAB_SLACK_DOMAIN_STORE=1
MAB_SLACK_DOMAIN_DB_PATH=/tmp/meeting-avatar-bot-data/slack-agent-domain.sqlite3
MAB_LEGACY_SLACK_WORKSPACE_DIR=/path/to/slack-agent/workspace
MAB_LEGACY_SLACK_AGENT_DB=/path/to/slack-agent/slack-agent.db

# Bring-your-own agent runner. The meeting/slack services are a thin shell;
# they do not implement an agent brain.
MAB_AGENT_RUNNER=dry-run
MAB_CODEX_BIN=codex
MAB_CODEX_MODEL=gpt-5.5
MAB_CLAUDE_BIN=claude
MAB_CLAUDE_MODEL=sonnet
MAB_CLAUDE_READ_PERMISSION_MODE=dontAsk
MAB_CLAUDE_WRITE_PERMISSION_MODE=acceptEdits
MAB_CLAUDE_MAX_BUDGET_USD=
MAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
MAB_OLLAMA_MODEL=llama3.2
MAB_SLACK_AGENT_D_URL=
MAB_SLACK_AGENT_D_TOKEN=
MAB_SLACK_AGENT_D_TIMEOUT_MS=120000
MAB_SLACK_AGENT_D_POLL_INTERVAL_MS=1000
MAB_AGENT_COMMAND=
MAB_AGENT_HTTP_URL=
MAB_DRY_RUN_AGENT=0
MAB_RUN_AGENT_REAL_TASK_SMOKE=0
MAB_REQUIRE_AGENT_REAL_TASK=0
MAB_AGENT_REAL_TASK_PROVIDERS=
MAB_AGENT_REAL_TASK_REPORT_DIR=reports
MAB_AGENT_REAL_TASK_TIMEOUT_MS=180000

# Speech seams used by the local dialog bridge. `event` STT means an external
# browser/native recognizer dispatches `meeting-avatar-local-utterance`; the
# default TTS provider returns a generated WAV data URL so smoke tests prove
# audio is routed into the avatar fake mic without a cloud key.
MAB_STT_PROVIDER=event
MAB_TTS_PROVIDER=tone-wav
MAB_TTS_VOICE=default
MAB_TTS_COMMAND=
MAB_TTS_HTTP_URL=

# Post-meeting artifact pipeline. This mirrors the old MeetD shape: full audio
# artifact, ASR/transcript JSON, summary Markdown, then publish to Slack/Canvas.
# `caption` ASR uses supplied captions/transcript events; `command` and `http`
# adapt to a real ASR provider.
MAB_MEETING_ARTIFACTS_DIR=/tmp/meeting-avatar-bot-data/meeting-artifacts
MAB_RECORD_MEETING=0
MAB_MEET_AUDIO_BACKEND=auto
MAB_RECAPPI_SDK_PATH=
# Go post-meeting quality providers. Leave provider/model blank to use caption
# fallback only. `openai` uses MAB_OPENAI_API_KEY; `gemini` uses GEMINI_API_KEY.
ONEESAMA_MEETING_ASR_PROVIDER=
ONEESAMA_MEETING_ASR_MODEL=
ONEESAMA_MEETING_ASR_LANGUAGE=zh
GEMINI_API_KEY=
ONEESAMA_GEMINI_ASR_MODEL=
ONEESAMA_MEETING_SUMMARY_MODEL=
ONEESAMA_MEETING_CALIBRATE_MODEL=
# Legacy TS artifact-pipeline aliases are still accepted by the Go config.
MAB_ASR_PROVIDER=caption
MAB_ASR_MODEL=gpt-4o-mini-transcribe
MAB_OPENAI_AUDIO_TRANSCRIPTIONS_URL=
MAB_ASR_LANGUAGE=auto
MAB_ASR_COMMAND=
MAB_ASR_HTTP_URL=
MAB_CANVAS_PUBLISHER=file
MAB_CANVAS_DIR=/tmp/meeting-avatar-bot-data/canvas
MAB_CANVAS_SLACK_CHANNEL=
MAB_CANVAS_SLACK_THREAD_TS=

# Optional runtime config.
MAB_SLACK_PORT=8780
MAB_MEETING_PORT=8781
MAB_PUBLIC_BASE_URL=http://127.0.0.1:8780
MAB_MEETING_AGENT_URL=http://127.0.0.1:8781
MAB_DATA_DIR=/tmp/meeting-avatar-bot-data
MAB_STATE_PROVIDER=json-file
MAB_STATE_SQLITE_PATH=/tmp/meeting-avatar-bot-data/meeting-avatar-bot.sqlite3
# Optional override for Meeting Agent -> Slack Agent lifecycle webhooks. When
# omitted, the Go runtime defaults to the local Slack Agent endpoint and writes
# a shared HMAC secret under the state data dir.
MAB_MEET_WEBHOOK_URL=
MAB_MEET_WEBHOOK_SECRET=
# Optional Google Meet caption language used by the Slack join option card and
# meetd runtime joins. Slack joins always request caption capture so ASR,
# action items, and Canvas summaries have transcript input.
MAB_CAPTURE_CAPTIONS=1
MAB_CAPTION_LANGUAGE=English
MAB_AVATAR_MODEL_URL=https://cdn.jsdelivr.net/gh/Live2D/CubismWebSamples@master/Samples/Resources/Hiyori/Hiyori.model3.json
MAB_AVATAR_LAYOUT=face
# Optional: directory containing live2dcubismcore.min.js, pixi.min.js,
# pixi-unsafe-eval.min.js, and pixi-live2d-display-cubism4.min.js. When set,
# the avatar init script inlines these old avatar-spike-proven deps via
# Playwright addInitScript, avoiding Google Meet CSP/Trusted Types script loads.
MAB_AVATAR_DEPS_DIR=
MAB_BOT_NAME="Meeting Avatar Bot"
MAB_WORKSPACE_EMAIL_DOMAIN=
MAB_BROWSER_HEADLESS=false
MAB_MEET_PROFILE_MODE=guest
MAB_BROWSER_USER_DATA_DIR=
MAB_SCREENSHOT_DIR=/tmp/meeting-avatar-bot

# Cutover safety. Keep `shadow` or `rollback` while old Slack Agent D / Meet D
# remains the production primary.
MAB_CUTOVER_MODE=new
MAB_CUTOVER_CANARY_PERCENT=0
MAB_CUTOVER_AUTO_ROLLBACK_ON_FAILURE=0
MAB_CUTOVER_REPORT_PATH=/tmp/meeting-avatar-bot-cutover/report.jsonl
MAB_SHADOW_TAP_SECRET=
MAB_SHADOW_TAP_REPORT_PATH=/tmp/meeting-avatar-bot-cutover/shadow-tap.jsonl
