# Optional real-room local dialog acceptance.
#
# Keep this file as an example only. Put the real room URL in your shell or a
# private env file that is not committed.
#
# Run:
#   set -a
#   source examples/real-meet-codex.env.example
#   set +a
#   MAB_REAL_MEET_URL=https://meet.google.com/xxx-yyyy-zzz npm run smoke:real-local-dialog

MAB_AGENT_RUNNER=codex
MAB_CODEX_BIN=codex
MAB_CODEX_MODEL=gpt-5.5
MAB_BROWSER_HEADLESS=false
MAB_TTS_PROVIDER=tone-wav

