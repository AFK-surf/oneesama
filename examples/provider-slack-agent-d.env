# Minimal Slack Agent D adapter provider demo.
#
# Dry-run + mock bridge contract smoke does not require the private old stack:
#   npm run smoke:slack-agent-d-provider
#
# Live adapter mode is intentionally fail-closed and requires an explicit bridge
# endpoint. The endpoint should accept the sanitized AgentRunner job payload and
# return either plain text or JSON like:
#   {"status":"completed","result":"...","jobId":"legacy_job_123"}
#
#   set -a
#   source examples/provider-slack-agent-d.env
#   set +a
#   npm run smoke:local-agent-dialog

MAB_AGENT_RUNNER=slack-agent-d
MAB_SLACK_AGENT_D_URL=http://127.0.0.1:19091/agent/run
MAB_SLACK_AGENT_D_TOKEN=
MAB_SLACK_AGENT_D_TIMEOUT_MS=120000
MAB_SLACK_AGENT_D_POLL_INTERVAL_MS=1000
MAB_BROWSER_HEADLESS=true
