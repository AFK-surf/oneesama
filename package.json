{
  "name": "oneesama",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI meeting avatar bot: Slack control plane, Google Meet joiner, Realtime voice, Live2D avatar, and worker delegation.",
  "homepage": "https://github.com/AFK-surf/oneesama",
  "bugs": {
    "url": "https://github.com/AFK-surf/oneesama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFK-surf/oneesama.git"
  },
  "type": "module",
  "bin": {
    "oneesama": "./src/cli.ts"
  },
  "scripts": {
    "doctor": "tsx src/cli.ts doctor",
    "dev:slack": "tsx apps/slack-agent/src/index.ts",
    "dev:meeting": "tsx apps/meeting-agent/src/index.ts",
    "dev:avatar-local": "tsx packages/core/src/avatar-runtime/local-browser-surface-cli.ts",
    "dev:avatar-playground": "tsx packages/core/src/avatar-runtime/avatar-playground-cli.ts",
    "prepare": "lefthook install",
    "setup:browsers": "playwright install chromium",
    "lint": "npm run lint:js && npm run lint:size && npm run lint:go",
    "lint:js": "eslint --max-warnings=0 . && npm run lint:oxlint",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:go": "./scripts/lint-go.sh full",
    "lint:go:new": "./scripts/lint-go.sh new",
    "lint:size": "node scripts/check-file-lines.mjs",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
